logs/
zerofall_config.json
secrets.json
model_memory.json
*.log
.environment_state.json
snapshot_*.zip
snapshot_*.zip.enc
snapshot_*.meta.json
*_API_KEY.txt

# ── 备份文件（我改代码时留的，不该进仓库） ──
*.bak
*.bak_*
*.bak-*

# ── 编辑器 ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 编辑脚本留下的临时/备份目录（开源时不该带上去）
_backup_*/
_stage_*/
*.bak
*.orig

# 快照本体（含本机数据）
snapshots/
# 可执行文件不进版本库
*.exe
# 图标备份
*.ico.bak
# 云端清理计划（本机数据）
cloud_prune_plan.json

# 测试跑出来的临时工作目录（test_acp_fileops 会建）
tests/_acp_probe/
# 源码包输出目录
dist_release/

# 维护者本地工具，不进仓库
#   check_open_source.py  内含敏感信息扫描正则
#   make_source_zip.py    打源码包，路径写死本机
#   upload_to_github.py   推送脚本，同理
check_open_source.py
make_source_zip.py
upload_to_github.py

# 云端迁移/加密的中间文件（可能含明文快照，绝不能进仓库）
*.zf-plain
*.zf-new
*.zf-verify
*.zf-tmp
*.zf-conflict
# 版本点与时间线（本机数据）
.zf-config-history/
timeline.jsonl
upgrade_cache.json
secret_vault.zfv
# 本机自检报告/个人笔记
自检报告_*.md
测试*.md
