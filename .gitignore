# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 打包产物 ──
build/
dist/
*.spec
_stage_*/

# ── 发布包（构建生成，不入库） ──
ZeroFall_v*.zip
SHA256SUMS.txt

# ── 图标生成中间产物 ──
icon_preview.png
icon_16.png
icon_32.png
icon_48.png
icon_64.png
icon_small_check.png

# ── 运行时数据，绝对不要提交 ──
